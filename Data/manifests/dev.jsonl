{"audio": "Data/audio/003187.wav", "text": "トレーニングもされるんですもんね？", "duration": 1.866}
{"audio": "Data/audio/001397.wav", "text": "これこれこれですよ！", "duration": 1.826}
{"audio": "Data/audio/002050.wav", "text": "実は市場に出荷される「つまもの」の７割が上勝産。", "duration": 7.699}
{"audio": "Data/audio/000739.wav", "text": "将棋界の中で、一番負かしにくい棋士だと思います。", "duration": 4.971}
{"audio": "Data/audio/004528.wav", "text": "本日お邪魔するのは東京・日本橋にある焼肉燈花。", "duration": 7.583}
{"audio": "Data/audio/000482.wav", "text": "そして、サンタナはフォークということで今日は結果球ということになりますが奪った三振はすべてカーブないしはフォークという投球だったんですね。", "duration": 12.272}
{"audio": "Data/audio/003837.wav", "text": "それで１回冷蔵庫に入れて冷やせば土台の完成です", "duration": 5.328}
{"audio": "Data/audio/002027.wav", "text": "ウフフフ。", "duration": 1.468}
{"audio": "Data/audio/001765.wav", "text": "だから昨日は徹夜で作って言われたとおりドレスを着て待っていたのに社長は現れず。", "duration": 10.448}
{"audio": "Data/audio/003244.wav", "text": "こちら、内面がマイクロ波で発熱する特殊構造のため、パスタや具材、水などを入れるだけで、オープン！", "duration": 14.562}
{"audio": "Data/audio/003509.wav", "text": "工藤会は暴力団対策法に基づいて全国で唯一特定危険指定暴力団に指定されていて福岡県公安委員会は引き続き、暴力的要求行為を行っているなどとして先月１０回目となる指定の延長を行っています。", "duration": 20.262}
{"audio": "Data/audio/004201.wav", "text": "パワハラなんかじゃねえよ。", "duration": 2.65}
{"audio": "Data/audio/001034.wav", "text": "あっ今は自転車に乗れるようになることです。", "duration": 7.856}
{"audio": "Data/audio/003970.wav", "text": "いつも世界選手権ですとヤロネンさんは、わりと若い選手を代表に入れて昨年の世界選手権では平均年齢２５２６歳で組んでいるんですよね。", "duration": 14.4}
{"audio": "Data/audio/003839.wav", "text": "あの少年を。", "duration": 3.161}
{"audio": "Data/audio/002711.wav", "text": "イスラエルは観光収入が元々、主な収入源だったので非常にダメージを受けている。", "duration": 5.148}
{"audio": "Data/audio/000880.wav", "text": "口に入れる前の顔。", "duration": 6.607}
{"audio": "Data/audio/000215.wav", "text": "字が難しいもん！", "duration": 1.778}
{"audio": "Data/audio/000433.wav", "text": "わかりました。", "duration": 2.014}
{"audio": "Data/audio/000148.wav", "text": "では再び、陸上自衛隊のヘリが消息を絶った宮古島市から中継でお伝えします。", "duration": 6.931}
{"audio": "Data/audio/004062.wav", "text": "アオカビの学名ペニシリウムにちなんでペニシリンと名付けた薬を開発した。", "duration": 8.775}
{"audio": "Data/audio/001376.wav", "text": "つれないな。", "duration": 4.394}
{"audio": "Data/audio/004878.wav", "text": "ある少女の家族は父母２人の姉一家全員が亡くなりました。", "duration": 8.268}
{"audio": "Data/audio/000613.wav", "text": "少しでも不審な点があったら１人で対処せず家族や周りの人、警察に相談してください。", "duration": 7.626}
{"audio": "Data/audio/003584.wav", "text": "見学会やります頭", "duration": 3.942}
{"audio": "Data/audio/000462.wav", "text": "なんという横暴だ。", "duration": 4.163}
{"audio": "Data/audio/000684.wav", "text": "きょうはお二人にも花をテーマにした曲を歌っていただきます。", "duration": 5.706}
{"audio": "Data/audio/002091.wav", "text": "楽しみですね。", "duration": 4.786}
{"audio": "Data/audio/004704.wav", "text": "お金もなかったしボロボロの家住んでたホンマテンション下がるんすよ。", "duration": 7.313}
{"audio": "Data/audio/003301.wav", "text": "すごかったですね。", "duration": 2.977}
{"audio": "Data/audio/002395.wav", "text": "ここからはサンゴちゃん激推しのスポットまずはピッツェリアピザラロハサンゴ", "duration": 12.858}
{"audio": "Data/audio/001783.wav", "text": "そこで出会ったのは弱虫で情けない自分の姿でした。", "duration": 9.014}
{"audio": "Data/audio/001496.wav", "text": "あの大岡弥四郎がな。", "duration": 6.491}
{"audio": "Data/audio/004652.wav", "text": "巨人、岡本対昨日のＭＶＰ", "duration": 2.885}
{"audio": "Data/audio/002591.wav", "text": "台湾をめぐる米中対立が深まればそれが現実味を帯びてくるという指摘もあります。", "duration": 5.989}
{"audio": "Data/audio/003392.wav", "text": "ワールドカップも行われているんです。", "duration": 2.666}
{"audio": "Data/audio/004920.wav", "text": "醸造家の果てしない夢をこの一杯に！", "duration": 3.698}
{"audio": "Data/audio/003022.wav", "text": "「お風呂いただきます」はお正月", "duration": 1.961}
{"audio": "Data/audio/000851.wav", "text": "こんだけいろいろカレー見てきて芸人がスタンダードなカレー作りたいってどういうことだよ終わんねえぞ番組。", "duration": 6.431}
{"audio": "Data/audio/005056.wav", "text": "答え思い付いたんだけど。", "duration": 4.612}
{"audio": "Data/audio/000447.wav", "text": "そうなんですよ。", "duration": 4.25}
{"audio": "Data/audio/001108.wav", "text": "あのね、うちのリビングがよく映るんですよいろんなところでね。", "duration": 3.653}
{"audio": "Data/audio/004795.wav", "text": "こちら、千葉は傘マークついてますが、雷を伴う可能性あり。", "duration": 4.416}
{"audio": "Data/audio/001377.wav", "text": "いきます。", "duration": 0.937}
{"audio": "Data/audio/001181.wav", "text": "人間みたいに音はしないんですって。", "duration": 2.328}
{"audio": "Data/audio/003136.wav", "text": "棒状のものを使って押し込むと通しやすいよ。", "duration": 4.954}
{"audio": "Data/audio/001380.wav", "text": "浜田君。", "duration": 1.354}
{"audio": "Data/audio/002893.wav", "text": "どっちもでしょ", "duration": 2.832}
{"audio": "Data/audio/004438.wav", "text": "まずは浅草のお隣実は", "duration": 5.504}
{"audio": "Data/audio/001800.wav", "text": "ちょっとＶＴＲ見て頂いていいですか？", "duration": 2.668}
{"audio": "Data/audio/003259.wav", "text": "間に合わないということだけじゃなくて皆さん、ワクチンはいっぱい打ったんですけどコロナのワクチンは打ったけれどもインフルエンザは打ってない方多いんじゃないでしょうか。", "duration": 10.457}
{"audio": "Data/audio/005166.wav", "text": "ちくわの穴は皆さんキュウリとかチーズなど歴史上、いろんなものが詰められてきたと思います。", "duration": 5.989}
{"audio": "Data/audio/003989.wav", "text": "先生に言うよ。", "duration": 2.766}
{"audio": "Data/audio/003109.wav", "text": "ちょっと論点が変わってくるかもしれないんですけれどもこの前ゼミ生と話して面白いことを聞きまして。", "duration": 5.865}
{"audio": "Data/audio/002198.wav", "text": "東山氏はエージェント会社の社長も兼務し井ノ原氏が副社長を務めるといいます。", "duration": 12.561}
{"audio": "Data/audio/003340.wav", "text": "メッセージは毎回くれるのかな。", "duration": 1.978}
{"audio": "Data/audio/004310.wav", "text": "パパにお休みは？", "duration": 1.65}
{"audio": "Data/audio/000896.wav", "text": "不倫していたのは夫のほうだったのか。", "duration": 5.644}
{"audio": "Data/audio/000137.wav", "text": "これも税抜きやったら９００なんぼとかなのでめちゃめちゃ安いし今日やろうってなってもすぐ買いに行けるんでオススメです。", "duration": 9.702}
{"audio": "Data/audio/000624.wav", "text": "花が咲くと訪れる観光客のために、ユキツバキの周りを手入れしているところでした。", "duration": 7.037}
{"audio": "Data/audio/000491.wav", "text": "葉を見ると１枚だけ黄色。", "duration": 5.992}
{"audio": "Data/audio/001190.wav", "text": "２０１８年には赤坂で見つかり、警察などが出動する騒ぎになっていました。", "duration": 6.81}
{"audio": "Data/audio/005220.wav", "text": "おじゃ。", "duration": 4.381}
{"audio": "Data/audio/001627.wav", "text": "食べていたのはおまんじゅう。", "duration": 2.277}
{"audio": "Data/audio/002575.wav", "text": "一方こちらはオフィス街にある店舗。", "duration": 7.589}
{"audio": "Data/audio/004398.wav", "text": "このおきゃくというのは、土佐弁で宴会のことだそうです。", "duration": 4.263}
{"audio": "Data/audio/000607.wav", "text": "被告人町田加奈江についた弁護人は刑事事件専門の松平弁護士。", "duration": 6.809}
{"audio": "Data/audio/000340.wav", "text": "まだ時間ありますし大技もあるので、もう少し力を抜いていきたいですね。", "duration": 5.949}
{"audio": "Data/audio/002074.wav", "text": "その点、いかがでしょうか？", "duration": 1.593}
{"audio": "Data/audio/001619.wav", "text": "昨日ですが脱原発について別に明日、来年やめろというつもりではありませんと発言。", "duration": 7.643}
{"audio": "Data/audio/002048.wav", "text": "建物にいた人は全員避難しけが人はいませんでした。", "duration": 5.777}
{"audio": "Data/audio/002249.wav", "text": "せの！", "duration": 1.201}
{"audio": "Data/audio/002290.wav", "text": "もともとは保護された猫たち。", "duration": 4.6}
{"audio": "Data/audio/004869.wav", "text": "藤森さんは、多分こうだよ。", "duration": 2.042}
{"audio": "Data/audio/004436.wav", "text": "それに伴い外国のモノを日本に輸入する場合でも値段が上がっているんです", "duration": 8.182}
{"audio": "Data/audio/004609.wav", "text": "きょうの橋は旋回橋でした「プチリョンコってなんだ？」", "duration": 22.441}
{"audio": "Data/audio/001195.wav", "text": "「祈り」と並んで今回見ていくテーマ", "duration": 5.452}
{"audio": "Data/audio/004060.wav", "text": "彼の頭脳は貴重だ。", "duration": 3.903}
{"audio": "Data/audio/000641.wav", "text": "たまにあるマシュマロのムニ", "duration": 3.208}
{"audio": "Data/audio/003377.wav", "text": "これもすべて一つ一つ", "duration": 2.657}
{"audio": "Data/audio/000155.wav", "text": "綾瀬さんだったら、スノーボードとスケートボード、どちらに挑戦してみたいか聞いてみると。", "duration": 7.541}
{"audio": "Data/audio/000480.wav", "text": "愚かな女を悲しませるために僕が小田原君を殺したんだ！", "duration": 4.33}
{"audio": "Data/audio/000212.wav", "text": "一度は訪れたい聖域・伊勢神宮。", "duration": 3.693}
{"audio": "Data/audio/004464.wav", "text": "フジモンどう思われますか？", "duration": 1.804}
{"audio": "Data/audio/001098.wav", "text": "これは。", "duration": 2.214}
{"audio": "Data/audio/002108.wav", "text": "ロシア軍は包囲するために攻勢を強めています。", "duration": 6.713}
{"audio": "Data/audio/002003.wav", "text": "意識が戻ったばかりですし。", "duration": 4.386}
{"audio": "Data/audio/004529.wav", "text": "キム・キョンテはパー。", "duration": 6.476}
{"audio": "Data/audio/000242.wav", "text": "私の喋りが面白いと思ってるって事でいいんですよね？", "duration": 4.719}
{"audio": "Data/audio/004141.wav", "text": "初めて作業に加わられたのです。", "duration": 4.78}
{"audio": "Data/audio/002630.wav", "text": "やってみましょか？", "duration": 3.651}
{"audio": "Data/audio/000068.wav", "text": "ロシアはこうした兵器で本当に核を使うのか。", "duration": 9.804}
{"audio": "Data/audio/002211.wav", "text": "週末にはドイツ全土から多くの観光客が駆けつけます。", "duration": 9.183}
{"audio": "Data/audio/004347.wav", "text": "どうして？", "duration": 0.961}
{"audio": "Data/audio/000783.wav", "text": "〈観覧車はカップルのデートスポットとしても有名〉", "duration": 4.699}
{"audio": "Data/audio/001793.wav", "text": "立ち食いの場合お客さんが長居しないうえ１人客が中心になるため会話などでの飛沫感染リスクが下がることも考えられます。", "duration": 14.799}
{"audio": "Data/audio/001796.wav", "text": "で守らなきゃいけない。", "duration": 1.538}
{"audio": "Data/audio/003082.wav", "text": "そして、テレビ朝日系列では２日夜８時からの「修造＆一茂のイミシン」にてスペイン戦の模様をたっぷりとお届けしていきます。", "duration": 11.976}
{"audio": "Data/audio/001584.wav", "text": "２人分のツアー料金とほぼ一致しますね。", "duration": 4.133}
{"audio": "Data/audio/003721.wav", "text": "多分空の上から見てるんじゃねえかなと思ってる。", "duration": 4.158}
{"audio": "Data/audio/003294.wav", "text": "いよいよ明日スタートではないんです。", "duration": 4.73}
{"audio": "Data/audio/001106.wav", "text": "意味のある音だとどうしてもそれを脳が理解しようとしますけど意味のない音でパターンがどんどん変わるっていうのが人間一番寝られるんですよね", "duration": 12.13}
{"audio": "Data/audio/003075.wav", "text": "三木さん、結果が出ましたけどこれは、そりゃそうだろうなと。", "duration": 4.009}
{"audio": "Data/audio/003297.wav", "text": "あとほら誤字ばっかりだし。", "duration": 3.893}
{"audio": "Data/audio/002377.wav", "text": "やはりこうバッターもある程度データが出てくるじゃないですか。", "duration": 4.472}
{"audio": "Data/audio/000483.wav", "text": "なのであんまり同業者に会うことはなかったです。", "duration": 6.299}
{"audio": "Data/audio/000302.wav", "text": "甘い？", "duration": 1.895}
{"audio": "Data/audio/004644.wav", "text": "商社で働くつもりだった関さんは海外と自由に行き来できるように日本の国籍を取得。", "duration": 10.205}
{"audio": "Data/audio/001459.wav", "text": "海外の企業としては初めてで、国土交通省は、アメリカの航空当局と協力して、安全性などの審査を進めていくことになりました。", "duration": 12.618}
{"audio": "Data/audio/004790.wav", "text": "リズムがあって聴いたサウンドがすごくいいです。", "duration": 4.805}
{"audio": "Data/audio/000094.wav", "text": "キャッチボールするって》", "duration": 2.137}
{"audio": "Data/audio/001904.wav", "text": "永野さん、どんな内容になっているでしょうか？", "duration": 3.62}
{"audio": "Data/audio/000945.wav", "text": "ねっ私も就職しよっかな・", "duration": 4.021}
{"audio": "Data/audio/002365.wav", "text": "はい。", "duration": 0.94}
{"audio": "Data/audio/003121.wav", "text": "そこで「夕暮れ」っていうのも効いているなっていうふうに思いました。", "duration": 3.897}
{"audio": "Data/audio/004490.wav", "text": "こうして頭への衝撃を和らげる仕組みになっているんです。", "duration": 7.207}
{"audio": "Data/audio/001176.wav", "text": "更に新華社通信ですと新型コロナウイルスワクチン合計４０００万回分これをミャンマー国内の９割以上に当たる数値ですが提供したということですね。", "duration": 11.469}
{"audio": "Data/audio/004595.wav", "text": "でもここの境内には生えてないですよね。", "duration": 5.458}
{"audio": "Data/audio/000707.wav", "text": "「何かやろうか」って言って「何したらいい？」", "duration": 5.211}
{"audio": "Data/audio/004213.wav", "text": "東京都で１万人を超えるのはおよそ２か月ぶりのことです。", "duration": 5.003}
{"audio": "Data/audio/004734.wav", "text": "今日どんな感じで？", "duration": 4.25}
{"audio": "Data/audio/005296.wav", "text": "倒したチームの負けとなりまして倒さなかった方に２ポイント入ります。", "duration": 12.201}
{"audio": "Data/audio/002779.wav", "text": "まずは包丁を使う時の運動です。", "duration": 3.857}
{"audio": "Data/audio/004422.wav", "text": "海水浴場を管理する組合によると３日前から海に風や海水の濁りが見られるようになったといいます。", "duration": 10.587}
{"audio": "Data/audio/001089.wav", "text": "先攻の日本はナンバーワン、ツーをとっています。", "duration": 7.421}
{"audio": "Data/audio/004330.wav", "text": "どうして目隠しなんか？いいの。", "duration": 5.835}
{"audio": "Data/audio/002421.wav", "text": "毎朝エビ食ってるの？", "duration": 3.333}
{"audio": "Data/audio/003972.wav", "text": "続いては夏休み特別企画です。", "duration": 3.33}
{"audio": "Data/audio/000615.wav", "text": "あなたは罪です！", "duration": 6.199}
{"audio": "Data/audio/000568.wav", "text": "それではスタジオの皆さんお返しします。", "duration": 3.223}
{"audio": "Data/audio/002168.wav", "text": "コンロまわりにフライパンをしまうスペースがなかったり重ねて収納していてな時ありますよね", "duration": 10.579}
{"audio": "Data/audio/000035.wav", "text": "そうですね。", "duration": 1.161}
{"audio": "Data/audio/004972.wav", "text": "恒大グループは１９９６年の創業以降中国各地で不動産事業を急拡大し巨大デベロッパーにのし上がりました。", "duration": 9.884}
{"audio": "Data/audio/001155.wav", "text": "それでは今朝も「シマエナガの歌」張りきっていってみよう。", "duration": 6.747}
{"audio": "Data/audio/002181.wav", "text": "それをどこまで増やせるかっていう。", "duration": 2.442}
{"audio": "Data/audio/004099.wav", "text": "だってそんなの合理的じゃないじゃん？", "duration": 4.04}
{"audio": "Data/audio/004675.wav", "text": "このことは他のヤツらには言わないでくれおおう大丈夫かごめんなつかまれどうしたんだよ", "duration": 14.689}
{"audio": "Data/audio/004859.wav", "text": "ノックオンがあったのですがその後、ノットリリースザボール。", "duration": 4.871}
{"audio": "Data/audio/002355.wav", "text": "パンもしっかり冷凍されております。", "duration": 3.247}
{"audio": "Data/audio/003228.wav", "text": "そして中継でもお伝えしました千葉県茂原市ではひざ下まで水につかりながら歩く人の姿が見られました。", "duration": 8.99}
{"audio": "Data/audio/005226.wav", "text": "山勢さんのお話に続けてご覧ください。", "duration": 7.314}
{"audio": "Data/audio/001899.wav", "text": "後ろでイベントっぽいのやってるの？", "duration": 3.182}
{"audio": "Data/audio/001752.wav", "text": "お楽しみにね。", "duration": 6.523}
{"audio": "Data/audio/002672.wav", "text": "あと、２３時間ですかね", "duration": 2.02}
{"audio": "Data/audio/000572.wav", "text": "この場面でもバントの構えを見せます", "duration": 3.192}
{"audio": "Data/audio/005211.wav", "text": "日本政府は先月、日本人女性１人とアメリカからの要請でアフガニスタン人１４人を自衛隊機で国外退避させましたが日本大使館などで働くアフガニスタン人スタッフらおよそ５００人の退避を実現できず課題となっています。", "duration": 20.05}
{"audio": "Data/audio/004871.wav", "text": "今井さん", "duration": 1.004}
{"audio": "Data/audio/000836.wav", "text": "フグを揚げているんですけど、やわらかさが残ったままで。", "duration": 3.607}
{"audio": "Data/audio/005281.wav", "text": "今日は丸を外して、梶谷が３番なんですね。", "duration": 5.904}
{"audio": "Data/audio/001091.wav", "text": "海外に住んでいたことがあるので。", "duration": 3.251}
{"audio": "Data/audio/001906.wav", "text": "そうだそのＤＪゾンビこそが５０年前のドラッケン・ジョーだ。", "duration": 10.062}
{"audio": "Data/audio/002998.wav", "text": "今何しゆう？", "duration": 2.237}
{"audio": "Data/audio/001568.wav", "text": "一方、崩壊した建物についての責任を追及する動きも出ています。", "duration": 7.216}
{"audio": "Data/audio/002185.wav", "text": "では材料を炒めていきます。", "duration": 5.31}
{"audio": "Data/audio/000040.wav", "text": "樹齢１３０年の八重紅", "duration": 4.262}
{"audio": "Data/audio/001302.wav", "text": "いいテンションできましたね。", "duration": 2.44}
{"audio": "Data/audio/004112.wav", "text": "昨日午前３時半ごろ、２階にいた娘のうち、１人が争う声を聞き１階に下りると知らない男と鉢合わせになりました。", "duration": 10.278}
{"audio": "Data/audio/003367.wav", "text": "いいですね、あっぱれがたくさん出て。", "duration": 6.273}
{"audio": "Data/audio/002529.wav", "text": "そしてそして南野が起点となりゴール。", "duration": 10.473}
{"audio": "Data/audio/004628.wav", "text": "６５年はちょっと古すぎるし、８７年は最近すぎるし、正解は２番の７４年。", "duration": 11.353}
{"audio": "Data/audio/000449.wav", "text": "もし四国新幹線が実現すればその経済効果は年間およそ１６９億円ともいわれており地元は一攫千金のビッグチャンスご存じ", "duration": 16.223}
{"audio": "Data/audio/000891.wav", "text": "京都市内では今朝からいのししの目撃情報が相次いでいました。", "duration": 4.787}
{"audio": "Data/audio/000507.wav", "text": "チャルマースが出てきました。", "duration": 1.538}
{"audio": "Data/audio/002659.wav", "text": "「君の声が聴きたい」では引き続き若い世代の皆さんからの声を募集しています。", "duration": 10.128}
{"audio": "Data/audio/001211.wav", "text": "帰国を前に、岸田総理大臣はＧ７広島サミットについて、次のように述べました。", "duration": 9.795}
{"audio": "Data/audio/000243.wav", "text": "公認心理師で心療内科医の熊野宏昭さんです。", "duration": 5.182}
{"audio": "Data/audio/003428.wav", "text": "従来の回線の途中では光を電気に変換する際に電力を消費し、熱も発生。", "duration": 9.139}
{"audio": "Data/audio/000481.wav", "text": "江東区にありました。", "duration": 4.461}
{"audio": "Data/audio/001036.wav", "text": "それでは参りましょう。", "duration": 3.159}
{"audio": "Data/audio/003586.wav", "text": "恐らく、アラブ連盟はもう少し人道面を優先したいんでしょうけど現実というものがあってできないと思うんですよね。", "duration": 8.071}
{"audio": "Data/audio/001874.wav", "text": "ところが。", "duration": 3.923}
{"audio": "Data/audio/004987.wav", "text": "そこは訪れるだけで時代の最先端を感じられる駅との事。", "duration": 5.096}
{"audio": "Data/audio/001054.wav", "text": "ぜんぜんよさがわからない。", "duration": 2.02}
{"audio": "Data/audio/002167.wav", "text": "あとは順番に合わせていってください", "duration": 2.741}
{"audio": "Data/audio/001046.wav", "text": "確かにそうかもしれませんね。", "duration": 1.802}
{"audio": "Data/audio/004081.wav", "text": "村井さん「Ｄ」。", "duration": 1.77}
{"audio": "Data/audio/002771.wav", "text": "〈世界で１点しか確認されていない初期の肉筆画もあり美術館の新たな目玉になっています〉", "duration": 8.312}
{"audio": "Data/audio/000655.wav", "text": "《開演時間の１０時になった》", "duration": 5.293}
{"audio": "Data/audio/003744.wav", "text": "青の「一番搾り糖質ゼロ」", "duration": 5.859}
{"audio": "Data/audio/002517.wav", "text": "この辺りの海では珍しい獲物じゃな。", "duration": 6.892}
{"audio": "Data/audio/000965.wav", "text": "失礼します。", "duration": 2.753}
{"audio": "Data/audio/000384.wav", "text": "どちらを選ぶかという問題です。", "duration": 3.535}
{"audio": "Data/audio/001546.wav", "text": "ここでインサイド。", "duration": 4.693}
{"audio": "Data/audio/003065.wav", "text": "本当に諦めずに夢を追いかけたパターンですね。", "duration": 5.291}
{"audio": "Data/audio/005163.wav", "text": "ツーアウトになって７番の石田恋のタイムリーヒット。", "duration": 6.057}
{"audio": "Data/audio/004392.wav", "text": "何か見つけたら教えてください。", "duration": 2.798}
{"audio": "Data/audio/000435.wav", "text": "今シーズンもメジャーの中心であることは間違いなさそうです。", "duration": 8.196}
{"audio": "Data/audio/001252.wav", "text": "「いやいやいや知ってるっちゅうふうに言われると困るんでございますけどあの何でございますよ旦", "duration": 6.324}
{"audio": "Data/audio/000578.wav", "text": "午後３時過ぎの熊谷駅前です。", "duration": 3.62}
{"audio": "Data/audio/005077.wav", "text": "それを決定づける", "duration": 2.553}
{"audio": "Data/audio/003604.wav", "text": "はい木久扇さん。", "duration": 1.515}
{"audio": "Data/audio/000706.wav", "text": "最高気温を見ていきましょう。", "duration": 2.464}
{"audio": "Data/audio/002051.wav", "text": "新島さんが鹿革を染めたバッグです。", "duration": 7.97}
{"audio": "Data/audio/002426.wav", "text": "うん。", "duration": 2.016}
{"audio": "Data/audio/003806.wav", "text": "加工後の写真は素顔ではないので元の素顔も残しておけばよかったと後悔しているそうです。", "duration": 10.861}
{"audio": "Data/audio/004298.wav", "text": "また改めて伺います", "duration": 1.826}
{"audio": "Data/audio/004412.wav", "text": "そのツテは田んぼと同じ福島県内こんにちは！", "duration": 10.342}
{"audio": "Data/audio/004048.wav", "text": "健康には免疫力歯にはフッ素で抵抗力をそこでコレッ！", "duration": 8.31}
{"audio": "Data/audio/000779.wav", "text": "じゃあ佐久間さん", "duration": 3.561}
{"audio": "Data/audio/002472.wav", "text": "結果的に車両の床が低くなってホームとの間に高さ段差ができるというわけですね。", "duration": 6.578}
{"audio": "Data/audio/001908.wav", "text": "１年中、甘いトマトを供給できないかってお声が、消費者の方からそういう声が多いと。", "duration": 7.919}
{"audio": "Data/audio/001356.wav", "text": "この樹脂をふたたび繊維にそして織り上げると真っ白な生地になります", "duration": 10.801}
{"audio": "Data/audio/001446.wav", "text": "そして韓国２１歳のチョ・ソンジェ。", "duration": 6.798}
{"audio": "Data/audio/000249.wav", "text": "池田勇太に２打差と迫ります今平です。", "duration": 4.331}
{"audio": "Data/audio/001183.wav", "text": "創業者の北村重威が岩倉具視の側用人だったことから岩倉など政財界人の支援を受けて店を開いたのです。", "duration": 12.028}
{"audio": "Data/audio/001624.wav", "text": "やっぱやるよな。", "duration": 1.202}
{"audio": "Data/audio/003713.wav", "text": "どういうことですだ？", "duration": 2.143}
{"audio": "Data/audio/005278.wav", "text": "［今のレゴは進化してるんですね］", "duration": 4.009}
{"audio": "Data/audio/003053.wav", "text": "実は賃金の額そのもの", "duration": 2.318}
{"audio": "Data/audio/000459.wav", "text": "２０１４年以来の金メダル！", "duration": 3.902}
{"audio": "Data/audio/003543.wav", "text": "でもね実はヒトも幹細胞を持ってるんだよ。", "duration": 6.463}
{"audio": "Data/audio/001972.wav", "text": "はい。", "duration": 2.798}
{"audio": "Data/audio/000490.wav", "text": "ここはもう捕まっちゃいますよ。", "duration": 1.874}
{"audio": "Data/audio/002341.wav", "text": "そこにどう対応するかですね。", "duration": 3.995}
{"audio": "Data/audio/002251.wav", "text": "そこにはある信念が込められていました。", "duration": 5.402}
{"audio": "Data/audio/001781.wav", "text": "マッキー晩ごはんオムライスだよね？", "duration": 5.547}
{"audio": "Data/audio/004626.wav", "text": "そうなのよ。", "duration": 1.618}
{"audio": "Data/audio/003900.wav", "text": "今回、初の映画化を決めたわけは？", "duration": 6.494}
{"audio": "Data/audio/003011.wav", "text": "中国政府は今年１月から３月までのＧＤＰ＝国内総生産の実質成長率について、前の年の同じ時期のプラス４．５％だと発表しました。", "duration": 12.668}
{"audio": "Data/audio/004730.wav", "text": "これは？", "duration": 2.216}
{"audio": "Data/audio/001921.wav", "text": "続いて史上３人目の永世名人誕生なるか⁉フルポン", "duration": 6.042}
{"audio": "Data/audio/000850.wav", "text": "［動画やあいている文字をヒントにその名前をお答えください］", "duration": 5.648}
{"audio": "Data/audio/004566.wav", "text": "崩れたところからの攻撃を１本で決めようとしない。", "duration": 3.22}
{"audio": "Data/audio/004939.wav", "text": "上ですか？", "duration": 0.912}
{"audio": "Data/audio/000538.wav", "text": "実は余にもおぬしの父の正体や由来がよく分からぬ気になることもあっておぬしに何度か聞こうとしたがその度に清子にガードされていた《ご先祖様", "duration": 9.469}
{"audio": "Data/audio/000815.wav", "text": "マチスコープならみえるかな？", "duration": 3.133}
{"audio": "Data/audio/004879.wav", "text": "渋いですね。", "duration": 1.153}
{"audio": "Data/audio/004247.wav", "text": "分かったぁ。", "duration": 6.684}
{"audio": "Data/audio/002880.wav", "text": "まさか上様がこの峰山まで。", "duration": 5.356}
{"audio": "Data/audio/000154.wav", "text": "雑念が入るのでしゃべらないようにします。", "duration": 4.521}
{"audio": "Data/audio/000751.wav", "text": "はい。", "duration": 0.768}
{"audio": "Data/audio/001426.wav", "text": "いっただきます！", "duration": 5.159}
{"audio": "Data/audio/002791.wav", "text": "高さがありましたがちょっと着氷乱れました。", "duration": 5.177}
{"audio": "Data/audio/001770.wav", "text": "生きよう！", "duration": 4.009}
{"audio": "Data/audio/000200.wav", "text": "リスキリングをやっている人の数が少ないんですよね。", "duration": 3.557}
{"audio": "Data/audio/004910.wav", "text": "そして、明日の夕方６時鹿児島県にかなり接近してくる予想です。", "duration": 4.897}
{"audio": "Data/audio/004114.wav", "text": "現在１７位Ｊ１残留に向けて崖っぷちの状況のガンバ大阪が宇佐美のコーナーキックからファン・アラーノのヘディングシュートで１点を先制しています。", "duration": 15.003}
{"audio": "Data/audio/003003.wav", "text": "なんか生活の中とかでけっこう語い力を使うと大人に見えるから。", "duration": 6.576}
{"audio": "Data/audio/004783.wav", "text": "「私は新作のコート買っちゃった」", "duration": 2.774}
{"audio": "Data/audio/003090.wav", "text": "おっ早くも東大寺学園のエース松複雑な計算式を書き始めました。", "duration": 8.318}
{"audio": "Data/audio/005322.wav", "text": "落ち着かない。", "duration": 1.105}
{"audio": "Data/audio/004410.wav", "text": "そのときも変化球だったと思うんですけどこのケース、バッテリーからすると反則球、清水選手の場合、フォークが甘く入った場合、一番怖いでしょうね。", "duration": 11.911}
{"audio": "Data/audio/003114.wav", "text": "へえ。", "duration": 0.815}
{"audio": "Data/audio/003071.wav", "text": "うわ！", "duration": 1.487}
{"audio": "Data/audio/002754.wav", "text": "悪くなったわけじゃないストーリーが悪くなったわけじゃないなぜかといってえと撮影方法が変わったんです", "duration": 4.711}
{"audio": "Data/audio/004538.wav", "text": "そういうことで、リスキリング、学び直しということで、みんながどんどん転職をしながらスキルアップできるようにするというのを一応、盛り込んでいると。", "duration": 10.55}
{"audio": "Data/audio/001842.wav", "text": "少ないぐらい？", "duration": 1.778}
{"audio": "Data/audio/000699.wav", "text": "新しくなったモーニングショットですよ", "duration": 2.02}
{"audio": "Data/audio/001708.wav", "text": "人を信じてください、大丈夫ですから。", "duration": 2.258}
{"audio": "Data/audio/002026.wav", "text": "トークではそんな西太后の悪女エピソードが話題に「嫉妬深かった西太后は夫にかわいがられていた側室麗妃を捕まえ両手両足を切り落とした上に」", "duration": 17.506}
{"audio": "Data/audio/002752.wav", "text": "歯と歯ぐきのイラストが目印です。", "duration": 2.583}
{"audio": "Data/audio/004914.wav", "text": "投打二刀流で６勝目を狙う大谷。", "duration": 5.107}
{"audio": "Data/audio/003064.wav", "text": "釣り竿のレンタル餌なども完備。", "duration": 6.223}
{"audio": "Data/audio/004640.wav", "text": "どうして？", "duration": 4.258}
{"audio": "Data/audio/004905.wav", "text": "プーチン大統領はそういうアナログ型でその辺のネットの使い方とかよくわからなかったところがあると思うんですね。", "duration": 7.45}
{"audio": "Data/audio/002172.wav", "text": "まあね見れば分かるだろう", "duration": 3.383}
{"audio": "Data/audio/005195.wav", "text": "およよかよ。", "duration": 4.985}
{"audio": "Data/audio/003730.wav", "text": "２人の意外なプライベートも明かされました。", "duration": 4.251}
{"audio": "Data/audio/002471.wav", "text": "お疲れさまです。", "duration": 3.746}
{"audio": "Data/audio/000452.wav", "text": "まずはあのヒーロー映画の最新作の話題からクイズッス。", "duration": 5.102}
{"audio": "Data/audio/004256.wav", "text": "ということでこの時間のお相手はＨｅｙ！", "duration": 2.714}
{"audio": "Data/audio/002580.wav", "text": "関東でもちょっと雲が多くて、一部にわか雨のところがあるんですけどね。", "duration": 5.537}
{"audio": "Data/audio/003156.wav", "text": "松元は予選の泳ぎとしては４８秒６６全体３番目で決勝の舞台に進んできました。", "duration": 7.189}
{"audio": "Data/audio/004262.wav", "text": "何かとてもヘルシーにそれでアクセントになるし。", "duration": 6.436}
{"audio": "Data/audio/004389.wav", "text": "荒井さん、表情が明るくなって、さらにお酒も減ったということですよね。", "duration": 4.854}
{"audio": "Data/audio/002772.wav", "text": "町田が中を締めていく。", "duration": 1.729}
{"audio": "Data/audio/000841.wav", "text": "はい。", "duration": 1.062}
{"audio": "Data/audio/000792.wav", "text": "でもともかく年内は１０枚ほどまああんまり大きくしたくないってことでしたよね。", "duration": 6.474}
{"audio": "Data/audio/003217.wav", "text": "やって来たのは市内にあるグラウンドです。", "duration": 9.28}
{"audio": "Data/audio/001467.wav", "text": "お見事！", "duration": 3.937}
{"audio": "Data/audio/004303.wav", "text": "大きさも飛ぶ距離も日に日に伸びていった。", "duration": 4.91}
{"audio": "Data/audio/002737.wav", "text": "はい！", "duration": 0.768}
{"audio": "Data/audio/004351.wav", "text": "だからさんまさんダウンタウンさん", "duration": 3.126}
{"audio": "Data/audio/005153.wav", "text": "でもすごいのは表側だけじゃない。", "duration": 5.887}
{"audio": "Data/audio/002482.wav", "text": "ちょっと迷いが。", "duration": 1.394}
{"audio": "Data/audio/004514.wav", "text": "中でもにぎわいを見せていたのが月に１度行われ間生卵の詰め放題。", "duration": 7.545}
{"audio": "Data/audio/000907.wav", "text": "おいしそうでしたよね。", "duration": 1.97}
{"audio": "Data/audio/004714.wav", "text": "こしょうはものすごい入れた方がいい。", "duration": 2.835}
{"audio": "Data/audio/004345.wav", "text": "この先は、じゃあもう猛暑は来ない？", "duration": 3.755}
{"audio": "Data/audio/002623.wav", "text": "星マークね。", "duration": 2.158}
{"audio": "Data/audio/003952.wav", "text": "表紙はこちらです。", "duration": 1.778}
{"audio": "Data/audio/000386.wav", "text": "越谷市の南越谷に到着。", "duration": 9.279}
{"audio": "Data/audio/001612.wav", "text": "まだ続く。", "duration": 3.551}
{"audio": "Data/audio/001070.wav", "text": "ボールを打ちやすい所に持ってって左足できれいに狙ったところに正確ですよね。", "duration": 5.162}
{"audio": "Data/audio/004949.wav", "text": "今シーズン", "duration": 1.439}
{"audio": "Data/audio/004750.wav", "text": "みたいなことを物申したりするじゃないですか。", "duration": 2.443}
{"audio": "Data/audio/004194.wav", "text": "いかがですか？", "duration": 3.214}
{"audio": "Data/audio/004757.wav", "text": "月曜日の２度目の記者会見は途中から荒れに荒れた。", "duration": 11.436}
{"audio": "Data/audio/001440.wav", "text": "今日はね病気や体調の伝え方を覚えられたしいろいろ勉強になったよ。", "duration": 6.025}
{"audio": "Data/audio/000461.wav", "text": "じゃねえよ！", "duration": 0.866}
{"audio": "Data/audio/000845.wav", "text": "でもそれが面白いってことやもんね？", "duration": 2.164}
{"audio": "Data/audio/003998.wav", "text": "何がどうなってんのん？っていう感じ。", "duration": 2.566}
{"audio": "Data/audio/003390.wav", "text": "ああまあ安いか２人で割ったら。", "duration": 2.637}
{"audio": "Data/audio/004055.wav", "text": "ハハハハハ。", "duration": 1.833}
{"audio": "Data/audio/002171.wav", "text": "新型コロナの流行下では社会との接点が希薄になり考えの異なる人たちを批判する風潮が広がるなど社会の分断が進んでいます。", "duration": 12.51}
{"audio": "Data/audio/002964.wav", "text": "野党は。", "duration": 3.051}
{"audio": "Data/audio/004761.wav", "text": "こちらからは最新の情報をお伝えします。", "duration": 5.644}
{"audio": "Data/audio/004361.wav", "text": "なんで、こんなにたくさん熊が出てくるかということに関してはやはり特にこの１年、コロナ禍で人が動かなくなってしまって山村エリアですよね", "duration": 8.602}
{"audio": "Data/audio/004821.wav", "text": "で、この４人とともにデビューを目指すのが。", "duration": 4.987}
{"audio": "Data/audio/001525.wav", "text": "鉄道会社で働く内海和政さん。", "duration": 3.954}
